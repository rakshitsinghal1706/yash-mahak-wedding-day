.card-amp {font-size:.55em;color:#b38b3b}
.card-rule {
 position:relative;z-index:1;
 display:flex;align-items:center;gap:10px;
 width:65%;margin:11px auto 15px;
 color:#b68e3c;font-size:.85rem;
