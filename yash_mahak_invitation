<title>Yash & Mahak · Shubh Vivah</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Pinyon+Script&family=Tiro+Devanagari+Sanskrit&display=swap');
:root{
 --em-950:#02140f;--em-900:#052e22;--em-800:#0a3f2f;--em-700:#0f553f;--em-600:#17694f;
 --gold:#c9a24a;--gold-light:#ead39a;--gold-pale:#f6ebc9;--gold-deep:#8f6c24;
 --ivory:#f8f3e6;--paper:#fffdf7;--ink:#14211c;--muted:#5d6b64;
 --gold-grad:linear-gradient(110deg,#8f6c24 0%,#d8b766 20%,#f6ebc9 38%,#c9a24a 55%,#ead39a 75%,#8f6c24 100%);
 --gold-metal:linear-gradient(135deg,#a37e2c 0%,#f0dca0 46%,#c9a24a 66%,#8f6c24 100%);
 --script:'Pinyon Script',cursive;--serif:'Cormorant Garamond',Georgia,serif;--caps:'Cinzel',Georgia,serif;--deva:'Tiro Devanagari Sanskrit',serif;
 --lattice:repeating-linear-gradient(45deg,transparent 0 16px,#c9a24a12 17px 18px),repeating-linear-gradient(-45deg,transparent 0 16px,#c9a24a12 17px 18px);
 --lattice-ink:repeating-linear-gradient(45deg,transparent 0 17px,#8f6c2410 18px 19px),repeating-linear-gradient(-45deg,transparent 0 17px,#8f6c2410 18px 19px);
 --ease:cubic-bezier(.22,.8,.24,1)
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--em-950);color:var(--ivory);font-family:var(--serif);font-size:19px}
h1,h2,h3,p{margin:0}a,button{font:inherit;color:inherit}button{cursor:pointer}
.deva{font-family:var(--deva);letter-spacing:0!important}.eyebrow{font:500 .7rem/1.8 var(--caps);letter-spacing:.32em;text-transform:uppercase;color:var(--gold-light)}
.gold-text{background:var(--gold-grad);background-clip:text;color:transparent}
.ornament{display:block;width:min(230px,66%);height:26px;margin:18px auto;color:var(--gold)}
.intro{position:fixed;inset:0;z-index:20;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:clamp(14px,3vh,25px);padding:24px 16px;text-align:center;overflow:hidden;background:radial-gradient(ellipse at 50% 45%,var(--em-700) 0%,var(--em-900) 48%,var(--em-950) 100%);transition:opacity 1s ease,visibility 0s linear 1s}
.intro:before,.intro:after{content:"";position:absolute;inset:0;pointer-events:none}
.intro:before{background:var(--lattice);opacity:.75}
.intro:after{background:radial-gradient(circle at 15% 18%,#ead39a24 0 2px,transparent 3px),radial-gradient(circle at 82% 72%,#ead39a25 0 3px,transparent 4px),radial-gradient(circle at 73% 22%,#ead39a20 0 2px,transparent 3px)}
.intro.hide{opacity:0;visibility:hidden}
.intro-inner{position:relative;z-index:1;width:min(100%,520px);padding:28px 22px}
.intro .deva{font-size:clamp(1.1rem,4vw,1.4rem);color:var(--gold-light)}
.intro-names{font:clamp(3.2rem,12vw,5.7rem)/1.1 var(--script);color:var(--gold-pale);margin:10px 0;text-shadow:0 5px 24px #0007}
.intro-sub{font:500 .7rem var(--caps);letter-spacing:.28em;color:var(--gold-light);text-transform:uppercase}
.medallion{width:112px;height:112px;margin:12px auto;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 50% 38%,var(--em-700),var(--em-950));box-shadow:0 0 0 1.5px var(--gold),0 0 0 6px var(--em-950),0 0 0 7px #ead39ac0,0 18px 40px #0009,inset 0 0 26px #0006;color:var(--gold-light);font-size:49px}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:15px 27px;border:1px solid transparent;border-radius:2px;text-decoration:none;text-align:center;font:600 .68rem var(--caps);letter-spacing:.2em;text-transform:uppercase;transition:.3s}
.btn-gold{background:var(--gold-metal);color:var(--em-950);box-shadow:0 12px 30px -12px #c9a24abf}
.btn-ghost{background:transparent;color:var(--gold-light);border-color:#c9a24a99}
.btn-ghost:hover{background:#c9a24a18}
.tap{font:500 .62rem var(--caps);letter-spacing:.2em;color:#ead39a99;text-transform:uppercase}
main{opacity:0;visibility:hidden;transition:opacity 1s ease}main.open{opacity:1;visibility:visible}
.music-btn{position:fixed;right:16px;bottom:16px;z-index:10;border:1px solid #c9a24a88;border-radius:30px;background:#052e22ed;color:var(--gold-pale);padding:12px 15px;font:600 .62rem var(--caps);letter-spacing:.1em;box-shadow:0 5px 25px #0005}
.music-btn[hidden]{display:none}
.hero{position:relative;min-height:100svh;display:flex;align-items:center;justify-content:center;padding:100px 20px 85px;overflow:hidden;isolation:isolate;background:radial-gradient(ellipse at 50% 0%,#17694f 0%,#052e22 48%,#02140f 100%)}
.hero:before{content:"";position:absolute;inset:0;z-index:-1;background:var(--lattice);opacity:.7}
.hero:after{content:"";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 50% 50%,transparent 20%,#02140f88 100%)}
.hero-card{position:relative;width:min(100%,680px);padding:clamp(34px,7vw,70px) 22px;text-align:center;border:1px solid #c9a24a88;box-shadow:0 0 0 8px #02140f,0 0 0 9px #ead39a55,0 25px 80px #0005;background:#052e2270}
.corner{position:absolute;width:34px;height:34px;border:2px solid var(--gold);pointer-events:none}.tl{top:-7px;left:-7px;border-right:0;border-bottom:0}.tr{top:-7px;right:-7px;border-left:0;border-bottom:0}.bl{bottom:-7px;left:-7px;border-right:0;border-top:0}.br{bottom:-7px;right:-7px;border-left:0;border-top:0}
.hero .names{font:clamp(3.7rem,12vw,6.8rem)/1.08 var(--script);margin:20px 0;color:var(--gold-pale)}
.hero .date{font:500 .78rem var(--caps);letter-spacing:.22em;color:var(--gold-light);margin:22px 0}
.hero .introline{font:italic 500 clamp(1.1rem,4vw,1.35rem)/1.6 var(--serif);color:#f8f3e6dd;max-width:35ch;margin:auto}
.scroll-cue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);font:10px var(--caps);letter-spacing:.22em;color:var(--gold-light);text-transform:uppercase}
.scroll-cue i{display:block;width:1px;height:35px;background:var(--gold);margin:10px auto 0;opacity:.65}
.light-section{position:relative;padding:clamp(82px,12vw,120px) 18px;text-align:center;color:var(--ink);overflow:hidden;isolation:isolate;background:radial-gradient(ellipse at 50% 0%,#fffaf0,var(--ivory) 45%,#efe5cc)}
.light-section:before{content:"";position:absolute;inset:0;z-index:-1;background:var(--lattice-ink)}
.dark-section{position:relative;padding:clamp(82px,12vw,120px) 18px;text-align:center;overflow:hidden;isolation:isolate;background:linear-gradient(180deg,var(--em-950),var(--em-900))}
.dark-section:before{content:"";position:absolute;inset:0;z-index:-1;background:var(--lattice);opacity:.5}
.section-head{max-width:650px;margin:0 auto 35px}.section-title{font:400 clamp(2.8rem,11vw,4.7rem)/1.2 var(--script);margin:5px 0 10px;color:var(--gold-deep)}
.dark-section .section-title{color:var(--gold-pale)}
.lede{font:italic 500 clamp(1.1rem,3.8vw,1.3rem)/1.55 var(--serif);color:var(--muted);max-width:36ch;margin:auto}
.dark-section .lede{color:#f8f3e6c9}
.mantra{font:clamp(1.05rem,3.6vw,1.35rem)/2 var(--deva);color:var(--gold-deep);margin:25px auto;max-width:650px}
.invite-names{font:400 clamp(2.5rem,8vw,4.5rem)/1.15 var(--script);color:var(--em-900);margin:22px 0}
.invite-copy{font:500 clamp(1.2rem,4vw,1.45rem)/1.6 var(--serif);max-width:34ch;margin:0 auto;color:var(--muted)}
.date-line{font:500 .8rem var(--caps);letter-spacing:.16em;color:var(--gold-deep);margin:25px 0 13px}
.venue-name{font:600 clamp(1.45rem,5vw,2rem)/1.3 var(--serif);color:var(--em-900)}
.welcome{min-height:100svh;display:grid;place-items:center;text-align:center;padding:80px 22px;background:linear-gradient(#02140fe8,#052e22e8),var(--lattice),radial-gradient(ellipse at center,var(--em-700),var(--em-950));}
.welcome .welcome-text{font:italic 500 clamp(1.5rem,5vw,2.25rem)/1.5 var(--serif);max-width:26ch;margin:22px auto;color:var(--ivory)}
.event-card{max-width:570px;margin:30px auto 0;padding:clamp(30px,6vw,48px) 22px;background:var(--paper);border:1px solid #8f6c2475;box-shadow:0 0 0 8px var(--paper),0 0 0 9px #8f6c2440,0 35px 75px #052e2225;position:relative;color:var(--ink)}
.event-date{
  position:relative;
  display:table;
  margin:0 auto 14px;
  padding:10px 20px 11px;
  color:#795b20;
  font:600 .68rem/1.6 var(--caps);
  letter-spacing:.17em;
  text-transform:uppercase;
  background:linear-gradient(180deg,#fffaf0 0%,#f8efd9 100%);
  border-top:1px solid #c9a24a;
  border-bottom:1px solid #c9a24a;
  box-shadow:0 3px 10px #8f6c2410;
}
.event-date:before,.event-date:after{
  content:"✦";
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  color:#b68e3c;
  font-size:.62rem;
}
.event-date:before{left:7px}
.event-date:after{right:7px}
.event-title{font:600 clamp(2rem,7vw,3rem) var(--serif);color:var(--em-900);margin:12px 0}
.event-desc{font:italic 500 1.15rem/1.6 var(--serif);color:var(--muted);max-width:34ch;margin:0 auto}
.event-venue{max-width:430px;margin:22px auto 0;padding-top:16px;border-top:1px solid #b89a5a75;text-align:center}
.event-venue-label{font:600 .72rem var(--sans);letter-spacing:.2em;text-transform:uppercase;color:var(--gold-deep);margin:0 0 7px}
.event-venue-name{font:600 1.25rem var(--serif);color:var(--em-900);margin:0 0 4px}
.event-venue-address{font: .92rem/1.5 var(--sans);color:var(--muted);margin:0}
.dress{margin:24px auto 0;font:600 .72rem var(--caps);letter-spacing:.12em;color:var(--em-900)}
.swatches{display:flex;justify-content:center;gap:13px;margin:16px auto}
.swatch{width:25px;height:25px;border-radius:50%;border:1px solid #8a7864}.swatch.peach{background:#f1c6b1}.swatch.sky{background:#b8d7e7}
.timeline{max-width:650px;margin:35px auto 0;text-align:left;border-left:1px solid #c9a24a66;padding-left:26px}
.timeline-item{position:relative;margin:0 0 25px;padding:16px 20px;border:1px solid #c9a24a38;background:#f8f3e60b}
.venue-plain{max-width:650px;margin:28px auto 0;padding:0 18px;text-align:center}
.venue-plain h3{font:600 1.5rem var(--serif);color:var(--gold-light);margin:0 0 6px}
.venue-plain p{margin:0;color:#f8f3e6d9;line-height:1.5}
.timeline-item:before{content:"";position:absolute;left:-32px;top:22px;width:10px;height:10px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 5px var(--em-900),0 0 0 6px var(--gold)}
.timeline-item h3{font:600 1.5rem var(--serif);color:var(--gold-pale)}
.timeline-item p{color:#f8f3e6b8;margin-top:5px;line-height:1.5}
.departure-route{color:var(--gold-light)!important;font-size:.95rem;letter-spacing:.02em;margin-top:9px!important}
.count-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;max-width:520px;margin:34px auto}
.count-box{padding:20px 7px;border:1px solid #c9a24a77;border-radius:999px 999px 5px 5px;background:#f8f3e60a}
.count-box strong{display:block;font:500 clamp(1.7rem,7vw,3rem)/1.2 var(--serif);color:var(--gold-pale)}
.count-box span{font:500 .55rem var(--caps);letter-spacing:.13em;text-transform:uppercase;color:var(--gold-light)}
.venue-card{max-width:580px;margin:32px auto 0;padding:28px 20px;background:var(--paper);border:1px solid #8f6c2475;box-shadow:0 0 0 7px var(--paper),0 0 0 8px #8f6c2440;color:var(--ink)}
.actions{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin-top:23px}
footer{padding:75px 20px;text-align:center;background:var(--em-950);background-image:var(--lattice);border-top:1px solid #c9a24a55}
footer .final-blessing{font:1.4rem var(--deva);color:var(--gold-light)}
footer .final-names{font:clamp(2.8rem,9vw,4.5rem) var(--script);color:var(--gold-pale);margin:12px 0}
footer p{font:italic 1.1rem var(--serif);color:#f8f3e6a8}
@media(max-width:440px){.count-grid{gap:6px}.count-box{padding:16px 4px}.intro-inner{padding:22px 12px}}

/* Opening cover inspired by the supplied reference invitation */
.intro{background:radial-gradient(ellipse at 50% 42%,#0d6046 0%,#073a2b 43%,#02140f 100%)}
.intro:before{opacity:.48}
.intro:after{background:radial-gradient(circle at 15% 18%,#ead39a24 0 2px,transparent 3px),radial-gradient(circle at 82% 72%,#ead39a25 0 3px,transparent 4px),radial-gradient(circle at 73% 22%,#ead39a20 0 2px,transparent 3px)}
.intro-frame{position:absolute;inset:clamp(17px,4vw,34px);z-index:1;border:1px solid #d9b65f99;pointer-events:none;box-shadow:inset 0 0 0 5px #02140f55,inset 0 0 0 6px #ead39a55}
.intro-corner{position:absolute;width:42px;height:42px;border:2px solid var(--gold);filter:drop-shadow(0 0 5px #c9a24a44)}
.intro-tl{top:-5px;left:-5px;border-right:0;border-bottom:0}
.intro-tr{top:-5px;right:-5px;border-left:0;border-bottom:0}
.intro-bl{bottom:-5px;left:-5px;border-right:0;border-top:0}
.intro-br{bottom:-5px;right:-5px;border-left:0;border-top:0}
.intro-inner{width:min(100%,560px);padding:clamp(25px,5vh,48px) 22px;animation:cover-rise 1.2s cubic-bezier(.2,.75,.25,1) both}
.intro-blessing{animation:cover-rise .9s .12s both}
.intro-ornament{display:block;width:min(220px,62%);height:28px;margin:18px auto;color:var(--gold);animation:ornament-pulse 5s ease-in-out infinite}
.intro .medallion{position:relative;width:104px;height:104px;margin:16px auto 19px;border:1px solid var(--gold-light);box-shadow:0 0 0 5px #02140f,0 0 0 6px #ead39a99,0 0 35px #c9a24a35,inset 0 0 24px #0008;animation:medallion-glow 4s ease-in-out infinite}
.intro .medallion:before{content:"";position:absolute;inset:8px;border:1px solid #ead39a55;border-radius:50%}
.intro .medallion span{display:block;text-shadow:0 0 16px #ead39a77}
.intro-sub{animation:cover-rise .9s .28s both}
.intro-names{font-size:clamp(3.6rem,13vw,6.2rem);margin:16px 0 12px;background:linear-gradient(110deg,#f6ebc9 0%,#c9a24a 32%,#fff7dd 50%,#c9a24a 70%,#f6ebc9 100%);background-size:220% 100%;background-clip:text;-webkit-background-clip:text;color:transparent;text-shadow:none;animation:cover-rise 1s .38s both,cover-shimmer 8s 1.5s ease-in-out infinite}
.intro-ganesh{font-size:clamp(1rem,3.8vw,1.25rem);color:var(--gold-light);animation:cover-rise .9s .5s both}
.intro-message{font:italic 1.2rem var(--serif);color:#f8f3e6c9;margin-top:14px;animation:cover-rise .9s .6s both}
.intro-open{margin-top:25px;min-width:220px;position:relative;overflow:hidden;box-shadow:0 12px 32px -10px #c9a24acc;animation:cover-rise .9s .72s both,button-halo 3.5s 1.8s ease-in-out infinite}
.intro-open:after{content:"";position:absolute;top:-40%;left:-65%;width:35%;height:180%;transform:rotate(22deg);background:linear-gradient(90deg,transparent,#fff8dc99,transparent);animation:button-sheen 5s 2s ease-in-out infinite}
.intro-open span{margin-left:12px;font-size:.9rem}
.intro .tap{margin-top:18px;animation:cover-rise .9s .85s both}
.intro-spark{position:absolute;z-index:1;width:5px;height:5px;border-radius:50%;background:#f6ebc9;box-shadow:0 0 12px 3px #ead39a77;animation:spark-float 6s ease-in-out infinite;pointer-events:none}
.spark-one{left:17%;top:28%;animation-delay:-1s}
.spark-two{right:16%;top:39%;animation-delay:-3s}
.spark-three{left:27%;bottom:21%;animation-delay:-4.5s}
@keyframes cover-rise{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes cover-shimmer{0%,72%,100%{background-position:100% 50%}35%{background-position:0% 50%}}
@keyframes medallion-glow{0%,100%{box-shadow:0 0 0 5px #02140f,0 0 0 6px #ead39a99,0 0 25px #c9a24a22,inset 0 0 24px #0008}50%{box-shadow:0 0 0 5px #02140f,0 0 0 7px #ead39acc,0 0 42px #c9a24a66,inset 0 0 24px #0008}}
@keyframes ornament-pulse{0%,100%{opacity:.72;transform:scaleX(.96)}50%{opacity:1;transform:scaleX(1.04)}}
@keyframes button-halo{0%,100%{box-shadow:0 12px 32px -10px #c9a24acc}50%{box-shadow:0 12px 38px -8px #ead39acc}}
@keyframes button-sheen{0%,65%,100%{left:-65%}35%{left:135%}}
@keyframes spark-float{0%,100%{transform:translateY(0) scale(.8);opacity:.35}50%{transform:translateY(-18px) scale(1.35);opacity:.95}}
@media(max-width:440px){.intro-frame{inset:13px}.intro-corner{width:30px;height:30px}.intro-inner{padding:22px 14px}.intro .medallion{width:90px;height:90px}}
@media(prefers-reduced-motion:reduce){.intro-inner,.intro-blessing,.intro-sub,.intro-names,.intro-ganesh,.intro-message,.intro-open,.intro .tap,.intro-ornament,.intro .medallion,.intro-spark{animation:none!important}}


/* Invitation-card style opening screen */
.intro {
 background:
  radial-gradient(ellipse at 50% 45%,#15523e 0%,#073324 52%,#02140f 100%);
 padding:22px 16px;
}
.intro:before {
 background:
  repeating-linear-gradient(45deg,transparent 0 19px,#d9bd7410 20px 21px),
  repeating-linear-gradient(-45deg,transparent 0 19px,#d9bd7410 20px 21px);
 opacity:.85;
}
.intro:after {
 background:radial-gradient(ellipse at center,#c9a24a12 0%,transparent 68%);
}
.intro-frame,.intro-spark {display:none!important}
.intro-inner.invitation-card {
 position:relative;
 z-index:2;
 width:min(100%,460px);
 min-height:min(690px,calc(100svh - 48px));
 padding:clamp(36px,7vh,64px) clamp(24px,7vw,42px) 30px;
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
 gap:0;
 overflow:hidden;
 color:#12382b;
 text-align:center;
 background:
  radial-gradient(ellipse at 50% 0%,#fff 0%,transparent 58%),
  linear-gradient(145deg,#fffdf7 0%,#f8f1df 52%,#fffdf6 100%);
 border:1px solid #c9a24a;
 outline:1px solid #ead39a;
 outline-offset:5px;
 box-shadow:0 24px 90px #0009,0 0 0 12px #02140f66,inset 0 0 55px #c9a24a12;
 animation:card-unfold 1.15s cubic-bezier(.2,.8,.2,1) both;
}
.invitation-card:before {
 content:"";
 position:absolute;
 inset:11px;
 border:1px solid #b9944777;
 pointer-events:none;
}
.invitation-card:after {
 content:"";
 position:absolute;
 inset:17px;
 border:1px solid #b9944733;
 pointer-events:none;
}
.card-corner {
 position:absolute;
 z-index:2;
 width:32px;height:32px;
 border:2px solid #b68e3c;
}
.card-tl{top:13px;left:13px;border-right:0;border-bottom:0}
.card-tr{top:13px;right:13px;border-left:0;border-bottom:0}
.card-bl{bottom:13px;left:13px;border-right:0;border-top:0}
.card-br{bottom:13px;right:13px;border-left:0;border-top:0}
.card-topline {
 position:relative;z-index:1;
 font:500 clamp(1rem,3.8vw,1.2rem) var(--deva);
 color:#96732d;
 margin-bottom:8px;
}
.card-ornament {
 position:relative;z-index:1;
 width:min(210px,72%);height:34px;
 margin:12px auto 13px;
 color:#b68e3c;
}
.card-ganesha {
 position:relative;z-index:1;
 width:64px;height:64px;
 display:grid;place-items:center;
 margin:4px auto 20px;
 border:1px solid #c5a35c;
 border-radius:50%;
 outline:4px double #c5a35c66;
 outline-offset:4px;
