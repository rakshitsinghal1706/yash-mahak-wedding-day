<script>
const intro=document.getElementById('intro'),site=document.getElementById('site');
const audio=document.getElementById('bgMusic'),musicBtn=document.getElementById('musicBtn');
let invitationOpening = false;
async function openWeddingInvitation(){
 if(invitationOpening) return;
 invitationOpening = true;
 const envelope = document.getElementById('envelope');
 intro.classList.add('is-opening');
 envelope.classList.add('is-open');
 // Start audio during the tap gesture so mobile browsers can authorize playback.
 const musicStarted = audio.play().then(()=>true).catch(()=>false);
 // Let the flap turn and the paper rise before revealing the full invitation.
 window.setTimeout(async()=>{
  intro.classList.add('is-leaving');
  site.classList.add('open');
  musicBtn.hidden=false;
  if(!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
   const layer=document.createElement('div');
   layer.className='petal-shower';
   layer.setAttribute('aria-hidden','true');
   let longest=0;
   for(let i=0;i<34;i++){
    const petal=document.createElement('i');
    const rose=Math.random()<.38;
    const size=8+Math.random()*9;
    const duration=5.5+Math.random()*4;
    const delay=Math.random()*1.8;
    longest=Math.max(longest,duration+delay);
    petal.className=rose?'rose':'marigold';
    petal.style.cssText=`left:${Math.random()*100}%;width:${size}px;height:${size*1.25}px;--dur:${duration}s;--delay:${delay}s;--drift:${Math.round(Math.random()*150-75)}px;--spin:${Math.round(180+Math.random()*540)}deg`;
    petal.appendChild(document.createElement('b'));
    layer.appendChild(petal);
   }
   document.body.appendChild(layer);
   window.setTimeout(()=>layer.remove(),(longest+0.6)*1000);
  }
  if(await musicStarted){
   musicBtn.textContent='♫ Music: On';
   musicBtn.setAttribute('aria-pressed','true');
  }else{
   musicBtn.textContent='♫ Tap to Play Music';
  }
 },1900);
}
document.getElementById('openInvite').addEventListener('click',openWeddingInvitation);
document.getElementById('openSeal').addEventListener('click',openWeddingInvitation);
document.getElementById('envelope').addEventListener('keydown',event=>{
 if(event.key==='Enter'||event.key===' '){event.preventDefault();openWeddingInvitation();}
});
musicBtn.addEventListener('click',async()=>{
 if(audio.paused){try{await audio.play();musicBtn.textContent='♫ Music: On';musicBtn.setAttribute('aria-pressed','true')}catch(e){musicBtn.textContent='♫ Tap to Play Music'}}
 else{audio.pause();musicBtn.textContent='♫ Music: Off';musicBtn.setAttribute('aria-pressed','false')}
});
const target=new Date('2026-11-26T19:00:00+05:30').getTime();
function update(){
 const diff=target-Date.now(),box=document.getElementById('countdown');
 if(diff<=0){box.innerHTML='<p class="lede">The auspicious day is here — thank you for celebrating with us.</p>';return}
 const values=[Math.floor(diff/86400000),Math.floor(diff/3600000)%24,Math.floor(diff/60000)%60,Math.floor(diff/1000)%60],labels=['Days','Hours','Minutes','Seconds'];
 box.innerHTML=values.map((v,i)=>`<div class="count-box"><strong>${String(v).padStart(2,'0')}</strong><span>${labels[i]}</span></div>`).join('');
}
update();setInterval(update,1000);
const ics=['BEGIN:VCALENDAR','VERSION:2.0','BEGIN:VEVENT','DTSTART;TZID=Asia/Kolkata:20261126T190000','DTEND;TZID=Asia/Kolkata:20261126T230000','SUMMARY:Yash Gupta & Mahak Ahuja Wedding','LOCATION:Solitaire Grand Resorts, Padampur-Suratgarh Bypass Road, Sriganganagar','END:VEVENT','END:VCALENDAR'].join('\r\n');
document.getElementById('calendar').href='data:text/calendar;charset=utf-8,'+encodeURIComponent(ics);
</script>
